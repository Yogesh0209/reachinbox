# ========================================
# ReachInbox Environment Configuration
# ========================================

# Server
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/reachinbox

# Redis
REDIS_URL=redis://localhost:6379

# Session
SESSION_SECRET=change-this-to-a-random-secure-string

# Google OAuth (optional - set for Google login)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Development Auth (enable for local testing without Google OAuth)
DEV_AUTH_ENABLED=true

# Slack Integration (optional - set for Slack notifications)
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_CALLBACK_URL=http://localhost:3001/api/integrations/slack/callback

# SMTP / Ethereal Email
# Get test credentials at https://ethereal.email
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ETHEREAL_USER=
ETHEREAL_PASS=

# Elasticsearch (optional)
ELASTICSEARCH_URL=http://localhost:9200

# Worker Configuration
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100
